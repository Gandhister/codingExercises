"""

Given an array of integers where every integer occurs three times except for one integer, which only occurs once,
find and return the non-duplicated integer.

For example, given [6, 1, 3, 3, 3, 6, 6], return 1. Given [13, 19, 13, 13], return 19.

Do this in O(N) time and O(1) space.

"""

int_array = [6, 1, 3, 3, 3, 6, 6]
int_array = [13, 19, 13, 13]


def findUniqueVal(ints_list):
    unique_val = 0
    sub_set = []
    for i in range(0, len(ints_list)):
        for j in range(0, len(ints_list)):
            if i == j: 
                continue
            elif ints_list[i] != ints_list[j]:
                sub_set = ints_list[i+1:] + ints_list[:i]
                # sub_set.append(ints_list[:i])
                # print("Sub-set = ", sub_set)
                for val in sub_set:
                    if sub_set.count(ints_list[i]) >= 2: # val == ints_list[i] // sub_set.count(val) >= 2
                        continue
                    else:
                        unique_val = ints_list[i]
