package easy_e;

import java.util.ArrayList;
import java.util.List;
import java.util.Arrays;

/*
 11.09.2025
 
This problem was asked by Google.

You are writing an AI for a 2D map game. You are somewhere in a 2D grid, and there are coins 
strewn about over the map.

Given the position of all the coins and your current position, find the closest coin to you in 
terms of Manhattan distance. That is, you can move around up, down, left, and right, but not 
diagonally. If there are multiple possible closest coins, return any of them.

For example, given the following map, where you are x, coins are o, and empty spaces are . (top left is 0, 0):

---------------------
| . | . | x | . | o |
---------------------
| o | . | . | . | . |
---------------------
| o | . | . | . | o |
---------------------
| . | . | o | . | . |
---------------------
return (0, 4), since that coin is closest. This map would be represented in our question as:

Our position: (0, 2)
Coins: [(0, 4), (1, 0), (2, 0), (3, 2)]

*/
import java.util.HashMap;

public class NearestCoin {
	
	static char [][] grid = {{'.', '.', 'x', '.', 'o'}, {'o', '.', '.', '.', '.'}, 
			{'o', '.', '.', '.', 'o'}, {'.', '.', 'o', '.', '.'}};
	
	
	public static void main(String[] args) {
		
		System.out.println((find(0, 2, grid))); // Arrays.toString
	}
	
	public static ArrayList<int[]> find(int row, int col, char[][] grid) { 

		// store the coordinates of the coins in an ArrayList because I don't know how many
		// coins there'll be at the start
		List<int[]> coins = new ArrayList(); // <Integer>
		int dist = 0;
		int minDist = grid.length + grid[0].length;
		ArrayList<int[]> results = new ArrayList();
		
		for(int i = 0; i < grid.length; i++) { // i <= grid.length -1
			for(int j = 0; j < grid[i].length; j++) {
				
				if(grid[i][j] == 'o') {
					dist = Math.abs(i - row) + Math.abs(j - col);
					coins.add(new int[]{i, j, dist}); 
					if(dist <= minDist) {
						minDist = dist;
					}
				}
			}
		}
		
		for(int i = 0; i < coins.size(); i++) {
			if(coins.get(i)[2] == minDist) {
				results.add(coins.get(i));
			}
		}
		System.out.println("results: " + Arrays.toString(results.get(0)));
		return results; 
	}

}
