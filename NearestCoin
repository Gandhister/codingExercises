package easy_e;

import java.util.ArrayList;
import java.util.List;
import java.util.Arrays;

/*
 11.09.2025
 
This problem was asked by Google.

You are writing an AI for a 2D map game. You are somewhere in a 2D grid, and there are coins strewn about over the map.

Given the position of all the coins and your current position, find the closest coin to you in terms of Manhattan distance. That is, you can move around up, down, left, and right, but not diagonally. If there are multiple possible closest coins, return any of them.

For example, given the following map, where you are x, coins are o, and empty spaces are . (top left is 0, 0):

---------------------
| . | . | x | . | o |
---------------------
| o | . | . | . | . |
---------------------
| o | . | . | . | o |
---------------------
| . | . | o | . | . |
---------------------
return (0, 4), since that coin is closest. This map would be represented in our question as:

Our position: (0, 2)
Coins: [(0, 4), (1, 0), (2, 0), (3, 2)]

*/

public class NearestCoin {
	
	static char [][] grid = {{'.', '.', 'x', '.', 'o'}, {'o', '.', '.', '.', '.'}, 
			{'o', '.', '.', '.', 'o'}, {'.', '.', 'o', '.', '.'}};
	
	
	public static void main(String[] args) {
		
		find(0, 2, grid);
		System.out.println(Arrays.toString(find(0, 2, grid)));
	}
	
	public static int[] find(int x, int y, char[][] grid) { // void int[]
		
		// store the coordinates of the coins in an ArrayList because I don't know how many
		// coins there'll be at the start
		List<Integer[]> coins = new ArrayList(); // <Integer>
		for(int i = 0; i < grid.length; i++) { // i <= grid.length -1
			for(int j = 0; j < grid[i].length; j++) {
				if(grid[i][j] == 'o') {
					coins.add(new Integer[]{i, j}); 
				}
			}
		}
		
		
		// Once I know how many coins they'll be, I can store their respective index and
		// distance from x and y in an array. then find the minimum distance and note its position
		// so I can find it again
		int[] distances = new int[coins.size()];
		
		for(int k = 0; k < coins.size(); k++) { 
			int sum = 0;
			if(coins.get(k)[0] < x) { // coins.get(k[0])
				sum = x - coins.get(k)[0];
			} else if(coins.get(k)[0] > x) {
				sum = coins.get(k)[0] - x;
			} else
				sum = 0;
			if(coins.get(k)[1] < y) {
				sum += y - coins.get(k)[1];
			} else if(coins.get(k)[1] > y) {
				sum += coins.get(k)[1] - y;
			} else
				sum += 0; // for whatever reason I would (not) need that line ... :D
			distances[k] = sum;
		}
		
		int[] result = new int[3];
		int minDist = distances[0];
		for(int m = 0; m < distances.length; m++) {
			if(distances[m] < minDist) {
				minDist = distances[m];
			}
		}
		for(int n = 0; n < distances.length; n++) {
			if(distances[n] == minDist) {
				result[0] = minDist; // [1]
				result[1] = coins.get(n)[0];
				result[2] = coins.get(n)[1];
				System.out.println("The shortest distance is " + result[0] + 
						" for coin with the x, y coordinates: " + result[1] + " , " + result[2]);
				
			}
		}

		System.out.println("distances: " + Arrays.toString(distances));
		return result;
	}

}
