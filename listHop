"""

Given an integer list where each number represents the number of hops you can make, determine whether you can reach to 
the last index starting at index 0.

For example, [2, 0, 1, 0] returns True while [1, 1, 0, 1] returns False.

"""

listelein = [2, 0, 1, 0]
listelein = [1, 1, 0, 1]
print(listelein[len(listelein) - 2])
# print(len(listelein))


def listHop(listchen) -> bool:
    for i in range(len(listchen)- 1, 0, -1):
        if listchen[len(listchen)-2] == 1:
            continue
            if listchen[i] < len(listchen):
                continue
            else:
                return False
    return True

