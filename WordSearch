	public static boolean exists(char[][] grid, String sought, boolean[][] visited, int r, int c, int k) {
		
		if(k == sought.length()) {
			return true;
		}
		if(r < 0 || r > grid.length - 1) {
			return false;
		}
		if (c < 0 || c > grid[r].length -1) {
			return false;
		}
		if(grid[r][c] != sought.charAt(k)) {
			return false;
		}
		if(visited[r][c]) {
			return false;
		} 
		visited[r][c] = true;
		if (r - 1 >= 0            && exists(grid, sought, visited, r - 1, c, k + 1)) return true;
		if (r + 1 < grid.length   && exists(grid, sought, visited, r + 1, c, k + 1)) return true;
		if (c - 1 >= 0            && exists(grid, sought, visited, r, c - 1, k + 1)) return true;
		if (c + 1 < grid[r].length&& exists(grid, sought, visited, r, c + 1, k + 1)) return true;
		// return false;
		visited[r][c] = false;
		return false;
	}
	
	

}

