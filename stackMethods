"""

Implement a stack that has the following methods:

push(val), which pushes an element onto the stack
pop(), which pops off and returns the topmost element of the stack. If there are no elements in the stack, then it 
should throw an error or return null.
max(), which returns the maximum value in the stack currently. If there are no elements in the stack, then it should 
throw an error or return null.
Each method should run in constant time.

"""

# Stacks follow the LIFO-principle, i.e. last in, first out; think of Prof. Computerphile and his rings onto the stick

stack = []

def push(val):
    stack.insert(0, val)

def pop(val):
    if len(stack) == 0:
        return None
    else:
        stack.pop(0)

def max(keller):
    maxVal = 0
    for i in range(0, len(keller)):
        if keller[i] > maxVal:
            maxVal = keller[i]
    print(maxVal)

push(2)
push(4)
push(6)
print(stack)
max(stack)
