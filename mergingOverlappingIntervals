"""

Given a list of possibly overlapping intervals, return a new list of intervals where all overlapping intervals 
have been merged.

The input list is not necessarily ordered in any way.

For example, given [(1, 3), (5, 8), (4, 10), (20, 25)], you should return [(1, 3), (4, 10), (20, 25)].

"""

lista = [(1, 3), (5, 8), (4, 10), (20, 25)]

def mrgVrlppngNtrvls(cllctn):
    
    cllctn.sort()
    for i in range(0, len(cllctn)): #len(cllctn)-1
        for j in range(i + 1, len(cllctn)): # i + 1,
            if cllctn[i][1] > cllctn[j][0]: 
                cllctn[j] = (0,0) 
   
    k = 0
    while (k < len(cllctn)):
        if cllctn[k] == (0, 0):
            cllctn.pop(k)
        k = k + 1

    return cllctn

mrgVrlppngNtrvls(lista)
