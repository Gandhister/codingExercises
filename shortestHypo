package easy_e;

import java.util.Arrays;

/*
Given a set of points (x, y) on a 2D cartesian plane, find the two closest points. For example, 
given the points [(1, 1), (-1, -1), (3, 4), (6, 1), (-1, -6), (-4, -3)], return 
[(-1, -1), (1, 1)].

*/

public class shortestHypo {
	
	public static void main(String[] args) {
		int[][] points = {{1, 1}, {-1, -1}, {3, 4}, {6, 1}, {-1, -6}, {-4, -3}};
		

		System.out.println(Arrays.deepToString(shortest(points)));;
	}
	
	public static int[][] shortest(int[][] coordin){
		int[][] nearest = new int[2][2];
		double hypotenuse = 0;
		double shortestHypo = Double.MAX_VALUE;
		for(int i = 0; i < coordin.length; i++) {
			for(int j = 0; j < coordin.length; j++) {
				if(coordin == null) {
					break;
				}
				if(i == j) {
					continue;
				} else {
					hypotenuse = Math.sqrt(Math.pow(Math.abs(coordin[i][0] - coordin[j][0]), 2) 
							+ Math.pow(Math.abs(coordin[i][1] - coordin[j][1]), 2));
					
					if(hypotenuse <= shortestHypo) {
						shortestHypo = hypotenuse;
						nearest[0][0] = coordin[i][0]; 
						nearest[0][1] = coordin[i][1];
						nearest[1][0] = coordin[j][0];
						nearest[1][1] = coordin[j][1];
					}
				}
			}
		}
		System.out.println("shortestHypo: " + shortestHypo);
		return nearest;
	}
	
}
